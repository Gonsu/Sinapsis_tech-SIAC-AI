# Copia este archivo como .env y completa los valores.
# Sin ANTHROPIC_API_KEY el servidor usa el evaluador de pruebas (sin IA).

# Clave de https://platform.claude.com (nunca la subas al repositorio)
ANTHROPIC_API_KEY=

# Modelo de Claude a usar (opcional)
ANTHROPIC_MODEL=claude-opus-5

# Puerto del servidor Express
PORT=3001
