# Copia este archivo como .env y completa los valores.
# Configura al menos una clave de IA. Si hay varias, se usa la primera en este orden:
# Groq, Gemini, Claude (o la que indiques en AI_PROVIDER).
# Sin ninguna clave el servidor usa el evaluador de pruebas (sin IA).
# Nunca subas las claves al repositorio.

# Proveedor a usar: groq, gemini o claude (opcional)
AI_PROVIDER=

# Groq: clave de https://console.groq.com
GROQ_API_KEY=
# Modelo de Groq a usar (opcional)
GROQ_MODEL=openai/gpt-oss-120b

# Gemini: clave de https://aistudio.google.com
GEMINI_API_KEY=
# Modelo de Gemini a usar (opcional)
GEMINI_MODEL=gemini-3.8-flash

# Claude: clave de https://platform.claude.com
ANTHROPIC_API_KEY=
# Modelo de Claude a usar (opcional)
ANTHROPIC_MODEL=claude-opus-5

# Puerto del servidor Express
PORT=3001
