{
  "name": "sinapsis-tech-siac-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c red,blue \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.ts",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "build": "tsc -b && vite build",
    "test": "node --test \"server/**/*.test.ts\"",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@tailwindcss/vite": "^4.3.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
